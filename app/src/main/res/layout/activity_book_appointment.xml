<?xml version="1.0" encoding="utf-8"?>
<!-- book appointment screen -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F5F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book an Appointment"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <!-- dynamic subtitle -->
        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select a preferred date and time to consult with Dr. Sarah Jenkins."
            android:textSize="11sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- calendar card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_rounded"
            android:padding="16dp">

            <!-- month header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtMonth"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="September 2024"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPrev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="‹"
                    android:background="@drawable/bg_outline_small"
                    android:textColor="#7B1113" />

                <Button
                    android:id="@+id/btnNext"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="›"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_outline_small"
                    android:textColor="#7B1113" />

            </LinearLayout>

            <!-- calendar recycler -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp" />

            <!-- note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#EDF2F7"
                android:padding="10dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕒 Important Note: Please arrive 10 minutes prior to your appointment for registration."
                    android:textSize="10sp"
                    android:textColor="#4A5568" />

            </LinearLayout>

        </LinearLayout>

        <!-- available times card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_rounded"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕒 Available Times"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/txtSelectedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thursday, 12 September 2024"
                android:textSize="11sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REASON FOR VISIT"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#718096"
                android:layout_marginTop="20dp" />

            <EditText
                android:id="@+id/edtReason"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_light"
                android:hint="General Consultation"
                android:textSize="12sp"
                android:padding="10dp"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Confirm Booking →"
                android:background="@drawable/bg_button_maroon"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>