<?xml version="1.0" encoding="utf-8"?>
<!-- doctor registration screen - nested -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F0F0"
    android:fillViewport="true">

    <!-- main wrapper centered -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Doctor Registration"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="16dp" />

        <!-- card container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <!-- name field group -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <!-- name input -->
                <EditText
                    android:id="@+id/edtName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:hint="Name"
                    android:textSize="13sp"
                    android:padding="12dp" />

                <!-- name error -->
                <TextView
                    android:id="@+id/txtNameError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#D32F2F"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- surname field group -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <!-- surname input -->
                <EditText
                    android:id="@+id/edtSurname"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:hint="Surname"
                    android:textSize="13sp"
                    android:padding="12dp" />

                <!-- surname error -->
                <TextView
                    android:id="@+id/txtSurnameError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#D32F2F"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- email field group -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">

                <!-- email input -->
                <EditText
                    android:id="@+id/edtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:hint="Email"
                    android:inputType="textEmailAddress"
                    android:textSize="13sp"
                    android:padding="12dp" />

                <!-- email error -->
                <TextView
                    android:id="@+id/txtEmailError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#D32F2F"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- specialization field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp">

                <!-- spec input -->
                <EditText
                    android:id="@+id/edtSpec"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:hint="Specialization e.g Cardiology"
                    android:textSize="13sp"
                    android:padding="12dp" />

            </LinearLayout>

            <!-- password field group -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- password input -->
                <EditText
                    android:id="@+id/edtPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:textSize="13sp"
                    android:padding="12dp" />

                <!-- pass error -->
                <TextView
                    android:id="@+id/txtPassError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#D32F2F"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- signup button -->
            <Button
                android:id="@+id/btnSignup"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="SIGN UP AS DOCTOR"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_red_button"
                android:textColor="#FFFFFF" />

            <!-- login link row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <!-- already text -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have a doctor account? "
                    android:textSize="11sp"
                    android:textColor="#666666" />

                <!-- go login -->
                <TextView
                    android:id="@+id/txtGoLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Login"
                    android:textSize="11sp"
                    android:textColor="#D32F2F"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>