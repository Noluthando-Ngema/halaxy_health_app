<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFF9F0F0" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Doctor Registration" android:textSize="20sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="20dp">
            <EditText android:id="@+id/edtName" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:hint="Name" android:padding="12dp" android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/txtNameError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D32F2F" android:textSize="11sp" android:visibility="gone" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/edtSurname" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:hint="Surname" android:padding="12dp" android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/txtSurnameError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D32F2F" android:textSize="11sp" android:visibility="gone" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/edtEmail" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:hint="Email" android:padding="12dp" android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/txtEmailError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D32F2F" android:textSize="11sp" android:visibility="gone" android:layout_marginBottom="8dp"/>
            <EditText android:id="@+id/edtSpec" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:hint="Specialization e.g Cardiology" android:padding="12dp" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/edtPassword" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:hint="Password" android:inputType="textPassword" android:padding="12dp" android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/txtPassError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D32F2F" android:textSize="11sp" android:visibility="gone" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnSignup" android:layout_width="match_parent" android:layout_height="44dp" android:text="SIGN UP AS DOCTOR" android:background="@drawable/bg_red_button" android:textColor="#FFFFFF"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Already have a doctor account? " android:textSize="11sp"/>
                <TextView android:id="@+id/txtGoLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Login" android:textSize="11sp" android:textColor="#D32F2F" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>