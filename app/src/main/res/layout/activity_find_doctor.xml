<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find a practitioner"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000"
            android:layout_marginBottom="16dp"/>

        <!-- search bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="10"
            android:gravity="center_vertical">
            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="0dp"
                android:layout_weight="5"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_white"
                android:hint="Search by name, specialty or clinic."
                android:textSize="12sp"
                android:padding="10dp"
                android:layout_marginEnd="6dp"/>
            <EditText
                android:id="@+id/edtLocation"
                android:layout_width="0dp"
                android:layout_weight="3.5"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_white"
                android:hint="Psychiatrist"
                android:textSize="12sp"
                android:padding="10dp"
                android:layout_marginEnd="6dp"/>
            <Button
                android:id="@+id/btnSearch"
                android:layout_width="0dp"
                android:layout_weight="1.5"
                android:layout_height="44dp"
                android:text="Search"
                android:background="@drawable/bg_button_maroon"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- doctors grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recDoctors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_small_card"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:text="🕒 Recently Viewed"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#000"/>
                <TextView
                    android:id="@+id/txtRecent1"
                    android:text="• Dr. Sarah Jenkins (GP)"
                    android:textSize="11sp"
                    android:layout_marginTop="8dp"/>
                <TextView
                    android:id="@+id/txtRecent2"
                    android:text="• Dr. Michael Chen (Physio)"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF0F0"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginTop="12dp">
                <TextView
                    android:text="NEED URGENT CARE?"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#7B1113"/>
                <TextView
                    android:text="If you are experiencing a medical emergency, please call 000 immediately or visit your closest emergency department."
                    android:textSize="11sp"
                    android:textColor="#7B1113"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>