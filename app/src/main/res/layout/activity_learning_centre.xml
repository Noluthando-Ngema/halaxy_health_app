<?xml version="1.0" encoding="utf-8"?>
<!-- articles + youtube -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F5F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Learning Center"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Access expert advice and video resources."
            android:textSize="11sp"
            android:textColor="#666666"
            android:layout_marginBottom="16dp" />

        <!-- featured dark card -->
        <LinearLayout
            android:id="@+id/rootFeatured"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="vertical"
            android:background="@drawable/bg_dark_feature"
            android:padding="16dp"
            android:gravity="bottom">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★ FEATURED GUIDE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/txtFeaturedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mastering Your Wellness Dashboard"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- youtube player for featured -->
        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
            android:id="@+id/youtubeFeatured"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <!-- search for articles -->
        <EditText
            android:id="@+id/edtSearchLearn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_learning"
            android:hint="🔍 Search articles"
            android:textSize="12sp"
            android:paddingStart="16dp"
            android:layout_marginTop="16dp" />

        <!-- categories chips -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <!-- articles header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Health Articles"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- articles recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recArticles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- videos header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Videos from @halaxycommunity"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <!-- videos recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recVideos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnOpenChannel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Open @halaxycommunity Channel"
            android:background="@drawable/bg_button_maroon"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>