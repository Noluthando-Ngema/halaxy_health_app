<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F5F5">

    <!-- header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:background="#FFFFFF" android:padding="16dp" android:orientation="vertical">
        <TextView android:text="My Appointments" android:textSize="18sp" android:textStyle="bold" android:textColor="#000"/>
        <TextView android:text="Home / My Appointments" android:textSize="11sp" android:textColor="#888"/>
    </LinearLayout>

    <!-- empty state - shown when new patient has no appointments -->
    <LinearLayout android:id="@+id/layoutEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="40dp" android:visibility="gone">
        <TextView android:text="📅" android:textSize="40sp" android:gravity="center"/>
        <TextView android:text="No appointments yet" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:text="Book your first appointment with a doctor" android:textSize="11sp" android:textColor="#888" android:gravity="center"/>
        <Button android:id="@+id/btnBookFirst" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Book Now" android:background="@drawable/bg_red_button" android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- table header -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:background="#FFFFFF" android:layout_marginTop="12dp" android:elevation="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:minWidth="600dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:background="#F9F9F9" android:gravity="center_vertical" android:padding="10dp">
                <TextView android:layout_width="0dp" android:layout_weight="0.5" android:text="#" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="0dp" android:layout_weight="2" android:text="Doctor" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="0dp" android:layout_weight="2" android:text="Department" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="0dp" android:layout_weight="2" android:text="Date &amp; Time" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="0dp" android:layout_weight="1.2" android:text="Status" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="0dp" android:layout_weight="1.3" android:text="Action" android:textStyle="bold" android:textSize="11sp"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recAppointments" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>