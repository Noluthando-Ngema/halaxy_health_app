<?xml version="1.0" encoding="utf-8"?>
<!-- my appointments screen - nested -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- header section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Appointments"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <!-- breadcrumb -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home / My Appointments"
            android:textSize="11sp"
            android:textColor="#888888"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- empty state - shown when new patient has no appointments -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="gone">

        <!-- icon group -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- empty icon -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅"
                android:textSize="40sp"
                android:gravity="center" />

            <!-- empty title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No appointments yet"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginTop="12dp"
                android:gravity="center" />

            <!-- empty subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book your first appointment with a doctor"
                android:textSize="11sp"
                android:textColor="#888888"
                android:gravity="center"
                android:layout_marginTop="4dp" />

            <!-- book first button wrapper -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <!-- book button -->
                <Button
                    android:id="@+id/btnBookFirst"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Book Now"
                    android:background="@drawable/bg_red_button"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- appointments table section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <!-- horizontal scroll wrapper -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <!-- table content - min width for scroll -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:minWidth="600dp">

                <!-- table header row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:background="#F9F9F9"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <!-- # column -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="#"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:textColor="#000000" />

                    <!-- doctor column -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Doctor"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:textColor="#000000" />

                    <!-- department column -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Department"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:textColor="#000000" />

                    <!-- date time column -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Date &amp; Time"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:textColor="#000000" />

                    <!-- status column -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="Status"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:textColor="#000000" />

                    <!-- action column -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:text="Action"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:textColor="#000000" />

                </LinearLayout>

                <!-- recycler - appointment rows -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recAppointments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

</LinearLayout>