<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical" android:minWidth="600dp">
    <TextView android:id="@+id/txtRow" android:layout_width="0dp" android:layout_weight="0.5" android:text="#1" android:textSize="11sp"/>
    <TextView android:id="@+id/txtDoctor" android:layout_width="0dp" android:layout_weight="2" android:text="Dr. Sarah Smith" android:textSize="11sp" android:textStyle="bold"/>
    <TextView android:id="@+id/txtDept" android:layout_width="0dp" android:layout_weight="2" android:text="General Physician" android:textSize="11sp"/>
    <TextView android:id="@+id/txtDateTime" android:layout_width="0dp" android:layout_weight="2" android:text="2026-05-28 10:00 AM" android:textSize="10sp"/>
    <TextView android:id="@+id/txtStatus" android:layout_width="0dp" android:layout_weight="1.2" android:text="Pending" android:textSize="9sp" android:padding="5dp" android:gravity="center"/>
    <FrameLayout android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content">
        <Button android:id="@+id/btnCancel" android:layout_width="70dp" android:layout_height="28dp" android:text="Cancel" android:textSize="9sp" android:backgroundTint="#D32F2F" android:textColor="#FFFFFF" android:visibility="gone"/>
        <Button android:id="@+id/btnView" android:layout_width="70dp" android:layout_height="28dp" android:text="View" android:textSize="9sp" android:backgroundTint="#6C757D" android:textColor="#FFFFFF" android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>